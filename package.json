{
  "name": "cliff-camps-barot",
  "private": true,
  "version": "1.0.0",
  "description": "Cliff Camps, Barot - riverside Swiss tent camping website with built-in booking",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "seed": "npm run seed --workspace backend",
    "test": "npm test --workspace backend"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
