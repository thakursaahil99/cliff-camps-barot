# ---------------------------------------------------------------------------
# Cliff Camps backend - copy to backend/.env for local dev.
# On Netlify set the same keys in Site configuration -> Environment variables.
# ---------------------------------------------------------------------------

# Public site URL (used in emails, CORS and the iCal feed link). No trailing slash.
SITE_URL=http://localhost:5173
# Extra allowed CORS origins, comma separated (e.g. a custom domain)
ALLOWED_ORIGINS=

# Long random string (at least 32 chars). Signs admin JWTs and guest booking links.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Supabase (Project settings -> API). Leave empty locally to use the JSON dev store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROOFS_BUCKET=payment-proofs
# Force the local JSON store even when Supabase keys are present (dev only)
USE_MEMORY_DB=false

# --- Admin login created by `npm run seed`
ADMIN_EMAIL=cliffcampsbarot@gmail.com
ADMIN_PASSWORD=
# Where new-booking / payment alerts are sent
ADMIN_NOTIFY_EMAIL=cliffcampsbarot@gmail.com

# --- Booking rules
ADVANCE_PERCENT=30
TAX_PERCENT=0
PENDING_HOLD_HOURS=24
MAX_NIGHTS=30
MAX_MONTHS_AHEAD=12

# --- Email: EITHER Gmail SMTP with an App Password (Google account -> Security -> App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# ...OR Resend (free tier) - takes priority when set
RESEND_API_KEY=
MAIL_FROM=Cliff Camps Barot <cliffcampsbarot@gmail.com>

# --- UPI direct payments (zero fees). The camp's UPI ID, e.g. 8219850117@ybl
UPI_ID=
UPI_PAYEE_NAME=Cliff Camps

# --- Razorpay (dashboard -> Account & Settings -> API keys / Webhooks)
# Test mode: rzp_test_... keys with PAYMENTS_LIVE=false. Live: rzp_live_... keys with PAYMENTS_LIVE=true.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_LIVE=false

# --- Airbnb calendar sync (Airbnb -> Listing -> Calendar -> Availability -> Connect calendars -> Export)
AIRBNB_ICAL_URL=
# Tent type id (from Admin -> Tents) that the Airbnb listing represents. Empty = listing blocks the whole camp.
AIRBNB_TENT_ID=

# Local dev API port
PORT=4000
